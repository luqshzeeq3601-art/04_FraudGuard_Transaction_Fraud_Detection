{
  "seed": 42,
  "threads": 4,
  "raw_predictors": [
    "TransactionAmt",
    "ProductCD",
    "dist1",
    "dist2",
    "card4",
    "card6",
    "addr1",
    "addr2",
    "P_emaildomain",
    "R_emaildomain",
    "M4",
    "M6"
  ],
  "numeric_predictors": [
    "TransactionAmt",
    "dist1",
    "dist2"
  ],
  "categorical_predictors": [
    "ProductCD",
    "card4",
    "card6",
    "addr1",
    "addr2",
    "P_emaildomain",
    "R_emaildomain",
    "M4",
    "M6"
  ],
  "split_ratios": {
    "development": 0.60,
    "calibration": 0.10,
    "policy": 0.10,
    "final_test": 0.20
  },
  "policy": {
    "default_review_fraction": 0.01,
    "cost_parameters": {
      "missed_fraud_cost": 100.0,
      "review_cost": 1.0,
      "legitimate_friction_cost": 2.0
    },
    "cost_sensitivity_grid": {
      "missed_fraud_costs": [20.0, 100.0, 500.0],
      "review_costs": [0.5, 1.0, 2.0],
      "friction_costs": [0.0, 2.0, 5.0]
    }
  },
  "models": {
    "logistic": {
      "C_values": [0.1, 1.0, 10.0],
      "class_weights": [null, "balanced"],
      "max_iter": 1000
    },
    "lightgbm": {
      "n_estimators": [200, 400],
      "learning_rate": [0.03, 0.05, 0.1],
      "num_leaves": [15, 31, 63],
      "min_child_samples": [50, 100, 200],
      "weight_options": ["unweighted", "sqrt_imbalance"]
    }
  },
  "monitoring": {
    "psi_bins": 10,
    "missing_rate_threshold": 0.05,
    "unseen_category_threshold": 0.05,
    "psi_threshold": 0.2,
    "min_sample_warning": 100
  },
  "tracking": {
    "experiment_name": "FraudGuard",
    "tracking_uri": "sqlite:///mlflow.db"
  }
}
